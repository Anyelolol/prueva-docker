# Copiar este archivo a ".env" (en la raíz, junto al docker-compose.yml)
# y completar con valores reales antes de correr "docker compose up".
# Este .env NUNCA se sube a git.

DB_PASSWORD=cambia_esta_password
JWT_SECRET=genera_un_secreto_random_largo_aca

# URL pública desde la que el navegador del usuario va a llegar a b-arc.
# En local con los puertos default de este compose, dejar como está.
VITE_API_URL=http://localhost:8080/api
